{
  "name": "brixel-science-lab-ble",
  "version": "0.3.0",
  "description": "Bluetooth (BLE) edition of BRIXEL Science Lab: includes every Science Lab block plus wireless sending to Bowerbird Pro",
  "license": "MIT",
  "dependencies": {
    "core": "*",
    "bluetooth": "*",
    "brixel-science-lab": "github:brixel-editor/pxt-brixel-science-lab#v0.8.0"
  },
  "files": [
    "ble.ts",
    "README.md",
    "_locales/ko/brixel-science-lab-ble-strings.json",
    "_locales/en/brixel-science-lab-ble-strings.json"
  ],
  "testFiles": [
    "test.ts"
  ],
  "public": true,
  "supportedTargets": [
    "microbit"
  ],
  "preferredEditor": "blocksprj",
  "disablesVariants": [
    "mbdal"
  ],
  "yotta": {
    "configIsJustDefaults": true,
    "config": {
      "microbit-dal": {
        "bluetooth": {
          "enabled": 1,
          "pairing_mode": 0,
          "private_addressing": 0,
          "open": 1,
          "whitelist": 0,
          "advertising_timeout": 0,
          "tx_power": 6,
          "dfu_service": 0,
          "event_service": 1,
          "device_info_service": 1
        }
      }
    }
  }
}
